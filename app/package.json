{
  "name": "grug",
  "productName": "Grug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plans and whatever else goes in the sidebar, in one window.",
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "tsc -p electron && electron .",
    "dev": "vite",
    "test": "node --test electron/*.test.ts renderer/src/lib/*.test.ts",
    "typecheck": "tsc -p . && tsc -p electron --noEmit",
    "build": "rm -rf dist && vite build && tsc -p electron && node build.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.4.5",
    "lucide-react": "^1.48.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
