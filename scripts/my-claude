#!/usr/bin/env python3
"""Single entrypoint for the my-claude-stuff helper scripts.

Routes `my-claude <group> <command> [args]` to the underlying scripts in this
directory, so users get one namespaced command instead of a handful of raw
filenames on their PATH. Installed as a symlink by install-cli.py.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

SCRIPTS_DIR = Path(__file__).resolve().parent

# (group, command) -> (target script, leading args, positional-arg usage).
# Leading args are prepended before the user's, so e.g.
#   my-claude secret clear FOO  ->  set-secret.py --clear FOO
# The third field names the positionals this command takes ("" = none); a
# trailing "..." on the last one marks it greedy (one-or-more tokens, e.g. a
# free-text message). The dispatcher validates arity itself so the underlying
# script's usage text (which names internal files and remapped flags) is never
# surfaced to the user.
ROUTES: dict[tuple[str, str], tuple[str, list[str], str]] = {
    ("secret", "set"): ("set-secret.py", [], "<KEY>"),
    ("secret", "list"): ("set-secret.py", ["--list"], ""),
    ("secret", "clear"): ("set-secret.py", ["--clear"], "<KEY>"),
    ("viz", "set"): ("viz-set-current.py", [], "<figma-url-or-file-key>"),
    ("viz", "clear"): ("viz-set-current.py", ["--clear"], ""),
    ("viz", "reply"): ("viz-reply.py", [], "<comment-id> <message>..."),
    ("statusline", "install"): ("install-statusline.py", [], ""),
}

# Human-facing help, grouped. Kept in sync with ROUTES by hand (small + stable).
HELP_GROUPS: list[tuple[str, str, list[tuple[str, str]]]] = [
    (
        "secret",
        "Manage secrets in ~/.claude/secrets.env",
        [
            ("set <KEY>", "prompt for a value (hidden) and store it"),
            ("list", "list stored keys (values masked)"),
            ("clear <KEY>", "remove a key"),
        ],
    ),
    (
        "viz",
        "Track the current Figma file for the comments hook",
        [
            ("set <url|key>", "start tracking a Figma URL or file key"),
            ("clear", "stop tracking"),
            ("reply <id> <msg>", "post a reply in a comment thread"),
        ],
    ),
    (
        "statusline",
        "Manage the plugin statusline",
        [("install", "register the statusline in ~/.claude/settings.json")],
    ),
]


def print_help(stream=sys.stdout) -> None:
    print("my-claude — Evan's personal Claude Code plugin CLI\n", file=stream)
    print("Usage: my-claude <group> <command> [args]\n", file=stream)
    for group, summary, cmds in HELP_GROUPS:
        print(f"  {group:<11}{summary}", file=stream)
        for name, desc in cmds:
            print(f"    {name:<19}{desc}", file=stream)
        print("", file=stream)
    print("  help       show this help", file=stream)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("help", "-h", "--help"):
        print_help()
        return 0

    group = argv[0]
    known_groups = {g for g, _ in ROUTES}
    if group not in known_groups:
        print(f"my-claude: unknown group {group!r}\n", file=sys.stderr)
        print_help(sys.stderr)
        return 2

    if len(argv) < 2:
        verbs = sorted(c for g, c in ROUTES if g == group)
        print(
            f"my-claude: '{group}' needs a command ({', '.join(verbs)})",
            file=sys.stderr,
        )
        return 2

    command = argv[1]
    route = ROUTES.get((group, command))
    if route is None:
        verbs = sorted(c for g, c in ROUTES if g == group)
        print(
            f"my-claude: unknown command '{group} {command}' (try: {', '.join(verbs)})",
            file=sys.stderr,
        )
        return 2

    script, lead, arg_usage = route
    user_args = argv[2:]
    # Honor an explicit end-of-options marker: `my-claude viz set -- -x` should
    # treat -x as the value, not count `--` toward arity.
    if user_args and user_args[0] == "--":
        user_args = user_args[1:]

    # Own arity validation so a clean "usage: my-claude <group> <command> ..."
    # is shown instead of the underlying script's internal usage line. Each
    # token in arg_usage is one positional; a trailing "..." makes the last one
    # greedy (>=1 token). Non-greedy requires an exact count.
    expected = arg_usage.split()
    greedy = bool(expected) and expected[-1].endswith("...")
    count = len(expected)
    enough = len(user_args) >= count if greedy else len(user_args) == count
    if not enough or not all(a.strip() for a in user_args):
        usage = f"usage: my-claude {group} {command}"
        if arg_usage:
            usage = f"{usage} {arg_usage}"
        print(usage, file=sys.stderr)
        return 2

    target = SCRIPTS_DIR / script
    if not target.is_file():
        print(f"my-claude: missing target script {target}", file=sys.stderr)
        return 1

    # `--` so a positional that starts with a dash (e.g. a file key literally
    # named "--clear") is passed through as a value, not parsed as a flag.
    passthrough = ["--", *user_args] if user_args else []

    # Replace this process so interactive prompts (e.g. getpass on `secret set`)
    # keep the real tty, and the child's exit status is reported directly.
    cmd = [sys.executable, str(target), *lead, *passthrough]
    os.execv(sys.executable, cmd)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
